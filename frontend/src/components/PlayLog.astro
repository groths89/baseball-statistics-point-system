---
import { fmtPts, ordinal, tone, type Breakdown } from '../lib/api';

interface Props {
  plays: Breakdown['play_log'];
  total: number;
}

const { plays, total } = Astro.props;
const logged = plays.reduce((sum, p) => sum + p.impact, 0);
const unlogged = total - logged;
const filters = [
  { id: 'all', label: 'All Events' },
  { id: 'high', label: 'High Impact (≥3)' },
  { id: 'miracles', label: 'Miracles' },
  { id: 'deductions', label: 'Deductions' },
];
const roman: Record<string, string> = { basic: 'I', situational: 'II', miracles: 'III', deductions: 'IV', carry_over: 'V' };
const names: Record<string, string> = {
  basic: 'Basic Stats',
  situational: 'Situational',
  miracles: 'Miraculous',
  deductions: 'Deductions',
  carry_over: 'Carry-Over',
};
const catLabel = (keys: string[]) =>
  keys.length === 1 ? `${roman[keys[0]]}. ${names[keys[0]]}` : `${keys.map((k) => roman[k]).join(' + ')} Blend`;
const catClass = (keys: string[]) => (keys.includes('miracles') ? 'miracle' : keys.every((k) => k === 'deductions') ? 'neg' : '');
// Bold the leading proper name so the actor stands out, as in the design
const split = (text: string) => {
  const m = text.match(/^((?:[A-ZÀ-Ý][\wÀ-ÿ'’.-]*\s)+?)(?=[a-z])/);
  return m ? { name: m[1].trim(), rest: text.slice(m[1].length) } : { name: '', rest: text };
};
const liClass = (n: number) => (n >= 3 ? 'lvl3' : n >= 2 ? 'lvl2' : n >= 1.2 ? 'lvl1' : 'lvl0');
const peakLi = plays.reduce<(typeof plays)[number] | null>((m, p) => (p.li !== null && (!m || p.li > (m.li ?? 0)) ? p : m), null);
const peak = plays.reduce<(typeof plays)[number] | null>((m, p) => (!m || Math.abs(p.impact) > Math.abs(m.impact) ? p : m), null);
const peakName = peak ? split(peak.description).name || 'play' : '';
---

<section class="card log">
  <div class="head">
    <div class="title">
      <h2>Situational Play Log</h2>
      <span class="chip">Scored micro-events ({plays.length} key plays)</span>
    </div>
    <div class="filters" role="group" aria-label="Filter plays">
      <span class="fl">Filter:</span>
      {filters.map((f) => <button type="button" class:list={['fbtn', { active: f.id === 'all' }]} data-filter={f.id}>{f.label}</button>)}
    </div>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th class="l">Inning</th>
          <th class="l">Outs</th>
          <th class="l">Count</th>
          <th class="l">Score</th>
          <th class="l">Play description</th>
          <th class="c">LI</th>
          <th class="r">Formula category</th>
          <th class="r">Impact</th>
        </tr>
      </thead>
      <tbody id="play-rows">
        {
          plays.map((p) => {
            const { name, rest } = split(p.description);
            return (
              <tr
                class:list={{ miracle: p.category_keys.includes('miracles') }}
                data-high={Math.abs(p.impact) >= 3}
                data-miracles={p.category_keys.includes('miracles')}
                data-deductions={p.impact < 0 || p.category_keys.includes('deductions')}
              >
                <td class="l inning">
                  {p.half} {ordinal(p.inning)}
                </td>
                <td class="l mono">{p.outs}</td>
                <td class="l mono">{p.count ?? '—'}</td>
                <td class="l score">{p.score}</td>
                <td class="l desc">
                  {name && <b>{name}</b>} {rest}
                  {p.detail && <small class="ev">{p.detail}</small>}
                  <small class:list={{ miracle: p.category_keys.includes('miracles') }}>{p.highlights.join(' · ')}</small>
                </td>
                <td class="c">
                  {p.li !== null ? <span class:list={['pill', liClass(p.li)]}>{p.li.toFixed(2)}</span> : <span class="mono">—</span>}
                </td>
                <td class:list={['r', 'catcell', catClass(p.category_keys)]}>{catLabel(p.category_keys)}</td>
                <td class={`r impact ${p.category_keys.includes('miracles') ? 'miracle' : tone(p.impact)}`}>{fmtPts(p.impact)} PTS</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  <div class="foot">
    <div class="stats">
      <span>Scored plays: <strong>{plays.length}</strong></span>
      {
        peakLi && (
          <>
            <span>•</span>
            <span>
              Peak scored-play LI: <strong class="amber">{peakLi.li!.toFixed(2)} ({split(peakLi.description).name || 'play'})</strong>
            </span>
          </>
        )
      }
      <span>•</span>
      <span>High-impact (≥3): <strong>{plays.filter((p) => Math.abs(p.impact) >= 3).length}</strong></span>
      {
        peak && (
          <>
            <span>•</span>
            <span>
              Peak play: <strong class="amber">{fmtPts(peak.impact)} ({peakName})</strong>
            </span>
          </>
        )
      }
    </div>
    <div>
      Showing <strong id="shown">{plays.length}</strong> of {plays.length} plays
      {Math.abs(unlogged) > 0.001 && <> • {fmtPts(unlogged)} pts from box-score totals &amp; carry-over (not tied to a play)</>}
    </div>
  </div>
</section>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#play-rows tr'));
  const shown = document.getElementById('shown');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter!;
      buttons.forEach((b) => b.classList.toggle('active', b === button));
      let count = 0;
      rows.forEach((row) => {
        const visible = filter === 'all' || row.dataset[filter] === 'true';
        row.hidden = !visible;
        if (visible) count++;
      });
      if (shown) shown.textContent = String(count);
    });
  });
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin: 16px 16px 0;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }
  .title {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  h2 {
    font-family: var(--font-head);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .chip {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
    color: var(--muted);
    background: var(--pill-bg);
    padding: 2px 8px;
    border-radius: 4px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
  }
  .fl {
    color: var(--muted);
  }
  .fbtn {
    padding: 2px 8px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }
  .fbtn:hover {
    background: var(--pill-bg);
  }
  .fbtn.active {
    background: var(--accent-tint);
    color: var(--text);
    font-weight: 600;
  }
  .table-wrap {
    margin: 0 16px;
  }
  th.c,
  td.c {
    text-align: center;
  }
  th.r,
  td.r {
    text-align: right;
  }
  td {
    padding-top: 12px;
    padding-bottom: 12px;
    vertical-align: top;
  }
  tr.miracle {
    background: rgba(167, 139, 250, 0.08);
  }
  .mono,
  .score,
  .catcell,
  .impact {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }
  .inning {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-weight: 600;
    white-space: nowrap;
  }
  .score {
    white-space: nowrap;
  }
  .desc {
    min-width: 260px;
    font-size: 12px;
  }
  .desc b {
    font-weight: 600;
  }
  .desc small {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
  }
  small.miracle,
  .catcell.miracle,
  .impact.miracle {
    color: #a78bfa;
    font-weight: 600;
  }
  .catcell {
    color: var(--muted);
    white-space: nowrap;
  }
  .catcell.neg {
    color: var(--neg);
  }
  .pill {
    display: inline-block;
    min-width: 22px;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
    background: var(--pill-bg);
    color: var(--muted);
  }
  small.ev {
    color: var(--text);
    opacity: 0.75;
  }
  .pill.lvl0 {
    background: var(--pill-bg);
    color: var(--muted);
  }
  .pill.lvl1 {
    background: rgba(74, 222, 128, 0.18);
    color: var(--pos);
  }
  .pill.lvl2 {
    background: rgba(245, 185, 66, 0.2);
    color: #d99a1c;
  }
  .pill.lvl3 {
    background: rgba(248, 113, 113, 0.2);
    color: #e5484d;
  }
  .pill.lvl-neg {
    background: rgba(248, 113, 113, 0.18);
    color: var(--neg);
  }
  .impact {
    font-weight: 700;
    font-size: 13px;
    white-space: nowrap;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 12px 16px 16px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .foot strong {
    color: var(--text);
  }
  .foot .amber {
    color: #f5b942;
  }
</style>
